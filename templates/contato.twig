	<div class="container scroll-anime">
		<div class="row">
			<div class="col-md-12">
				<h3>Deixe aqui sua dúvida</h3>

				<form id="formulario" action="/Contato-Escola-Pe-no-Chao" method="POST">
					<div class="row">
						<div class="col-md-4">
							<div class="form-group">
				    			<label for="nome">Nome:</label>
				    			<input type="text" class="form-control" id="nome" name="nome" placeholder="Seu nome" required>
				 			</div>
						</div>

						<div class="col-md-4">
							<div class="form-group">
				    			<label for="email">Email:</label>
				    			<input type="email" class="form-control" id="email" name="email" placeholder="exemplo@exemplo.com.br" required>
				  			</div>
						</div>

						<div class="col-md-4">
							<div class="form-group">
				    			<label for="fone">Telefone:</label>
				    			<input type="text" class="form-control" id="fone" name="fone" placeholder="(51)00000-0000 *Somente números" required>
				  			</div>
						</div>
					</div>

		  			<div class="row">
		  				<div class="col-md-12">
		  					<div class="form-group">
				    			<label for="msg">Mensagem:</label>
				    			<textarea class="form-control" rows="5" id="msg" name="msg" placeholder="Deixe aqui sua mensagem para nossa equipe." required></textarea>
				  			</div>
		  				</div>
		  			</div>

		  			<button type="submit" class="btn btn-default">Enviar</button>
				</form>
			</div>
			</div>
