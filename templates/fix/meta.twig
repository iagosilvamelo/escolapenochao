<!-- SEO Geral -->
<title>{{ title }}</title>
<meta name="title" content="{{ title }}">
<meta name="description" content="{{ description }}">
<meta name="subject" content="Escola de educação infantil.">
<meta name="abstract" content="Escolinha.">
<meta name="classification" content="business">
<meta name="coverage" content="Worldwide">
<link rel="canonical" href="{{ link }}">
<meta name="author" content="Iago Melo">
<meta name="robots" content="all">
<meta name="ICBM" content="-30.002194,-51.149951">
<meta name="geo.position" content="-30.002194,-51.149951" />
<meta name="geo.region" content="BR-RS" />
<meta name="geo.placename" content="Porto Alegre" />

<!-- Google+ / Schema.org -->
<meta itemprop="name" content="{{ title }}">
<meta itemprop="description" content="{{ description }}">
<meta itemprop="image" content="{{ asset ('public/img/logo.png') }}">
<link href="https://plus.google.com/u/0/106913247535366461133" rel="publisher">

<!-- Open Graph Facebook -->
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}"/>
<meta property="og:url" content="{{ link }}">
<meta property="og:site_name" content="SG Nutri"/>
<meta property="og:type" content="website">
<meta property="og:image" content="{{ asset ('public/img/logo.png') }}">
<meta property="article:author" content="/iago.melo">

<!-- Twitter -->
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:url" content="{{ link }}">
<meta name="twitter:card" content="summary">
<meta name="twitter:image" content="{{ asset ('public/img/logo.png') }}">
<meta name="twitter:creator" content="@iago_fabricio">
<meta name="twitter:site" content="@escolapenochao">


