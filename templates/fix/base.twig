<html lang="pt-br">
	<heal>
		<!-- Codificação caracteres da página -->
		<meta charset="utf-8">
		<meta http-equiv="x-ua-compatible" content="ie=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
		<meta name="robots" content="index,follow,noodp">
		<meta name="googlebot" content="index,follow">
		{% include 'fix/meta.twig' %}
		{% block head %}{% endblock %}
		<style>
			@-webkit-keyframes fadeIn {
			0% { opacity: 0; }
			100% { opacity: 1; } 
			}
			@-moz-keyframes fadeIn {
			0% { opacity: 0;}
			100% { opacity: 1; }
			}
			@-o-keyframes fadeIn {
			0% { opacity: 0; }
			100% { opacity: 1; }
			}
			@keyframes fadeIn {
			0% { opacity: 0; }
			100% { opacity: 1; }
			}

			.topo{min-height: 200px; line-height: 200px;}
			.topo #img-topo{margin-top: 50px}
			.topo h1{margin-top: 90px}

			.social-item{width: 35px; height: 35px; margin-left: 10px}

			body{
				background-image: url("https://www.sgnutri.com.br/img/img/bg.jpg");
				background-size: auto;
				background-attachment: fixed;
			}

			.page .container{
				background-color: rgba(230,255,255,0.9);
				border-radius: 15px;
			}
			.page h3{margin-top: 20px}

			.page .container a{ transition: color 0.2s linear 0s, background 0.2s linear 0s; color: #555555;}

			.page .container a:hover{ transition: color 0.2s linear 0s, background 0.2s linear 0s; color: #0078A8; text-decoration: none;}

			.fadeIn {
			-webkit-animation: fadeIn 1s ease-in-out;
			-moz-animation: fadeIn 1s ease-in-out;
			-o-animation: fadeIn 1s ease-in-out;
			animation: fadeIn 1s ease-in-out;
			}

			.scroll-anime{
				opacity: 0;
				transform: translate3d(-100px,0,0);
				transition: 0.6s;
			}
			.scroll-anime-start{
				opacity: 1;
				transform: translate3d(0,0,0);
			}
		</style>
	</head>

	<body>
		<section id="header" class="fadeIn">
			{% include 'fix/navbar.twig' %}
		</section>

		<section class="page">
			{% block container %}
			{% endblock %}
		</section>
		
		<section>
			{% include 'fix/footer.twig' %}
		</section>

		<script type="text/javascript">
			var $target = $('.scroll-anime'),
				animationClass = 'scroll-anime-start',
				offset = $(window).height() * 3/4;

			function animeScroll(){
				var documentTop = $(document).scrollTop();

				$target.each(function(){
					var itemTop = $(this).offset().top;

					if (documentTop > itemTop - offset){
						$(this).addClass(animationClass);
					} else {
						$(this).removeClass(animationClass);
					}
				});
			}

			animeScroll();

			$(document).scroll(function(){
				animeScroll();
			});
		</script>
	</body>
</html>