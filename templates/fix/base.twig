		<section class="page">
			{% block container %}
			{% endblock %}
		</section>
		
		<section>
			{% include 'fix/footer.twig' %}
		</section>

		<script type="text/javascript" src="{{ asset ('public/js/app.js') }}"></script>
	</body>
</html>